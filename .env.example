# ====================================================================
# NDDB AI4IT Demonstration Environment Configuration
# ====================================================================

# Neon Serverless PostgreSQL Connection Strings
# 1. Admin / Read-Write role (used to run schema/seed and demonstrate destructive agent prompt & auto-reset)
NEON_DATABASE_URL_ADMIN="postgresql://neondb_owner:[PASSWORD]@[HOST].neon.tech/neondb?sslmode=require"

# 2. Read-Only role (used for safe parameterized query agent tools and guardrails lab)
NEON_DATABASE_URL_READONLY="postgresql://readonly_user:NDDB_Readonly_Pass_2026!@[HOST].neon.tech/neondb?sslmode=require"

# Optional Embeddings / Vector search
OPENAI_API_KEY="sk-..."
EMBEDDING_MODEL="text-embedding-3-small"

# Live Mode Flag for Presentation Frontend
NEXT_PUBLIC_ENABLE_LIVE_BACKEND="false"
